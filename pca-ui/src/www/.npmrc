# Pin the lockfile format.
#
# package-lock.json in this repository is lockfileVersion 2. npm 7 through 10 write
# version 3 by default, so without this pin the format flips depending on which npm a
# contributor happens to have installed, producing enormous spurious diffs that bury the
# actual dependency change. Observed in practice: a routine install rewrote 25,000 lines
# of this file purely as a format migration.
#
# npm resolves the project .npmrc from the directory containing package.json, not by
# walking up to the repository root - verified - so each component with its own
# package.json needs its own copy of this file.
#
# Moving to version 3 is reasonable and probably desirable, but it should be a
# deliberate, standalone change rather than a side effect of someone's npm version.
lockfile-version=2

# Do not add registry credentials or auth tokens to this file. It is committed.

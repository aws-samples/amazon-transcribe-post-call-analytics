AWSTemplateFormatVersion: "2010-09-09"

Description: Amazon Transcribe Post Call Analytics - PCA UI - Api

Transform: AWS::Serverless-2016-10-31

Parameters:
  AudioBucket:
    Type: String

  AudioBucketPrefix:
    Type: String

  DataBucket:
    Type: String

  TableName:
    Type: String

  UserPoolId:
    Type: String

  GenAIQueryType:
    Default: 'DISABLED'
    Type: String
    AllowedValues:
      - 'DISABLED'
      # - 'SAGEMAKER'
      - 'BEDROCK'
      - 'LAMBDA'
      - 'ANTHROPIC'
    Description: This is what model to use for GenAIQuery.
  
  GenAIQueryBedrockModelId:
    Type: String
    Default: us.amazon.nova-pro-v1:0
    AllowedValues:
      - anthropic.claude-3-haiku-20240307-v1:0
      - us.anthropic.claude-haiku-4-5-20251001-v1:0
      - eu.anthropic.claude-haiku-4-5-20251001-v1:0
      - global.anthropic.claude-haiku-4-5-20251001-v1:0
      - anthropic.claude-3-sonnet-20240229-v1:0
      - us.amazon.nova-micro-v1:0
      - us.amazon.nova-lite-v1:0
      - us.amazon.nova-pro-v1:0
      - us.anthropic.claude-3-5-haiku-20241022-v1:0
      - us.anthropic.claude-3-5-sonnet-20241022-v2:0
      - eu.anthropic.claude-3-5-sonnet-20240620-v1:0
      - apac.anthropic.claude-3-5-sonnet-20240620-v1:0
    Description: (Optional) If 'GenAIQuery' is BEDROCK, which Bedrock model to use. (Bedrock preview access only)

  FetchTranscriptArn:
    Type: String
    AllowedPattern: '^(|arn:aws:lambda:.*)$'
    Description: Arn to use for the GenAIQuery to fetch transcript

  SummarizerArn:
    Type: String
    AllowedPattern: '^(|arn:aws:lambda:.*)$'
    Description: Arn to use to refresh the GenAI Summaries

  LLMThirdPartyApiKey:
    Type: String
    Description: >
      Secrets manager secret Arn containing the third party LLM API key
    Default: ''

  PyUtilsLayerArn:
    Type: String
    Description: External PyUtils Layer Arn to use.

  LLMTableName:
    Type: String
    Description: The DynamoDB table name where the summary and query prompt templates are stored.

  RolesTableName:
    Type: String

  AuditLogGroupName:
    Type: String

  TranscribeResultsPrefix:
    Type: String
    Default: transcribeResults
    Description: Prefix/folder in the output S3 bucket where Transcribe results are stored

  AdminUsername:
    Type: String

Conditions:
  HasAnthropicSummary: !Equals [!Ref GenAIQueryType, 'ANTHROPIC']
  # Mirrors the condition of the same name in pca-ui.template, which until now only
  # controlled a client-side display flag. Used below to stop creating the GenAI query
  # function and its /genaiquery route at all when the feature is disabled.
  ShouldEnableGenAIQuery: !Not [!Equals [!Ref GenAIQueryType, 'DISABLED']]

Resources:
  ApiAccessLogGroup:
    Type: AWS::Logs::LogGroup
    Properties:
      LogGroupName: /pca/apigateway
      RetentionInDays: 90

  ApiGatewayCloudWatchRole:
    Type: AWS::IAM::Role
    Properties:
      AssumeRolePolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Effect: Allow
            Principal:
              Service: apigateway.amazonaws.com
            Action: sts:AssumeRole
      ManagedPolicyArns:
        - arn:aws:iam::aws:policy/service-role/AmazonAPIGatewayPushToCloudWatchLogs

  ApiGatewayAccount:
    Type: AWS::ApiGateway::Account
    Properties:
      CloudWatchRoleArn: !GetAtt ApiGatewayCloudWatchRole.Arn

  Api:
    Type: AWS::Serverless::Api
    DependsOn: ApiGatewayAccount
    Properties:
      StageName: Prod
      AccessLogSetting:
        DestinationArn: !GetAtt ApiAccessLogGroup.Arn
        Format: '{"requestId":"$context.requestId","ip":"$context.identity.sourceIp","caller":"$context.identity.caller","user":"$context.identity.user","requestTime":"$context.requestTime","httpMethod":"$context.httpMethod","resourcePath":"$context.resourcePath","status":"$context.status","protocol":"$context.protocol","responseLength":"$context.responseLength","integrationLatency":"$context.integrationLatency"}'
      Auth:
        AddDefaultAuthorizerToCorsPreflight: False
        DefaultAuthorizer: Cognito
        Authorizers:
          Cognito:
            AuthType: COGNITO_USER_POOLS
            UserPoolArn: !Sub arn:aws:cognito-idp:${AWS::Region}:${AWS::AccountId}:userpool/${UserPoolId}
            AuthorizationScopes:
              - openid
      Cors:
        AllowOrigin: "'*'"
        AllowMethods: "'OPTIONS,GET,PUT,DELETE,POST'"
        AllowHeaders: "'Content-Type,Authorization'"
      GatewayResponses:
        DEFAULT_4XX:
          ResponseParameters:
            Headers:
              Access-Control-Allow-Origin: "'*'"
              Access-Control-Allow-Methods: "'OPTIONS,GET,PUT,DELETE,POST'"
              Access-Control-Allow-Headers: "'Content-Type,Authorization'"
        DEFAULT_5XX:
          ResponseParameters:
            Headers:
              Access-Control-Allow-Origin: "'*'"
              Access-Control-Allow-Methods: "'OPTIONS,GET,PUT,DELETE,POST'"
              Access-Control-Allow-Headers: "'Content-Type,Authorization'"

  HeadFunction:
    Type: "AWS::Serverless::Function"
    Properties:
      CodeUri:  ../../src/lambda
      Handler: head.handler
      Environment:
        Variables:
          TableName: !Ref TableName
          RolesTableName: !Ref RolesTableName
          AuditLogGroupName: !Ref AuditLogGroupName
      Events:
        APIEvent:
          Type: Api
          Properties:
            RestApiId: !Ref Api
            Method: GET
            Path: /head/{key+}
      Policies:
        - DynamoDBReadPolicy:
            TableName: !Ref TableName
        - DynamoDBReadPolicy:
            TableName: !Ref RolesTableName
        - Statement:
          - Sid: CloudWatchLogsAudit
            Effect: Allow
            Action:
              - logs:CreateLogStream
              - logs:PutLogEvents
              - logs:DescribeLogStreams
            Resource: !Sub arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:${AuditLogGroupName}:*
      Runtime: nodejs22.x

  GetFunction:
    Type: "AWS::Serverless::Function"
    Properties:
      CodeUri:  ../../src/lambda
      Handler: get.handler
      Environment:
        Variables:
          DataBucket: !Ref DataBucket
          AudioBucket: !Ref AudioBucket
          RolesTableName: !Ref RolesTableName
          AuditLogGroupName: !Ref AuditLogGroupName
      Events:
        APIEvent:
          Type: Api
          Properties:
            RestApiId: !Ref Api
            Method: GET
            Path: /get/{key+}
      Policies:
        - S3ReadPolicy:
            BucketName: !Ref DataBucket
        - S3ReadPolicy:
            BucketName: !Ref AudioBucket
        - DynamoDBReadPolicy:
            TableName: !Ref RolesTableName
        - Statement:
          - Sid: CloudWatchLogsAudit
            Effect: Allow
            Action:
              - logs:CreateLogStream
              - logs:PutLogEvents
              - logs:DescribeLogStreams
            Resource: !Sub arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:${AuditLogGroupName}:*
      Runtime: nodejs22.x

  ListFunction:
    Type: "AWS::Serverless::Function"
    Properties:
      CodeUri:  ../../src/lambda
      Handler: list.handler
      Environment:
        Variables:
          TableName: !Ref TableName
          RolesTableName: !Ref RolesTableName
          AuditLogGroupName: !Ref AuditLogGroupName
      Events:
        APIEvent:
          Type: Api
          Properties:
            RestApiId: !Ref Api
            Method: GET
            Path: /list
      Policies:
        - DynamoDBReadPolicy:
            TableName: !Ref TableName
        - DynamoDBReadPolicy:
            TableName: !Ref RolesTableName
        - Statement:
          - Sid: CloudWatchLogsAudit
            Effect: Allow
            Action:
              - logs:CreateLogStream
              - logs:PutLogEvents
              - logs:DescribeLogStreams
            Resource: !Sub arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:${AuditLogGroupName}:*
      Runtime: nodejs22.x

  SearchFunction:
    Type: "AWS::Serverless::Function"
    Properties:
      CodeUri:  ../../src/lambda
      Handler: search.handler
      Environment:
        Variables:
          TableName: !Ref TableName
          RolesTableName: !Ref RolesTableName
          AuditLogGroupName: !Ref AuditLogGroupName
      Events:
        APIEvent:
          Type: Api
          Properties:
            RestApiId: !Ref Api
            Method: GET
            Path: /search
      Policies:
        - DynamoDBReadPolicy:
            TableName: !Ref TableName
        - DynamoDBReadPolicy:
            TableName: !Ref RolesTableName
        - Statement:
          - Sid: CloudWatchLogsAudit
            Effect: Allow
            Action:
              - logs:CreateLogStream
              - logs:PutLogEvents
              - logs:DescribeLogStreams
            Resource: !Sub arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:${AuditLogGroupName}:*
      Runtime: nodejs22.x

  EntitiesFunction:
    Type: "AWS::Serverless::Function"
    Properties:
      CodeUri:  ../../src/lambda
      Handler: entities.handler
      Environment:
        Variables:
          TableName: !Ref TableName
          RolesTableName: !Ref RolesTableName
          AuditLogGroupName: !Ref AuditLogGroupName
      Events:
        APIEvent:
          Type: Api
          Properties:
            RestApiId: !Ref Api
            Method: GET
            Path: /entities
      Policies:
        - DynamoDBReadPolicy:
            TableName: !Ref TableName
        - DynamoDBReadPolicy:
            TableName: !Ref RolesTableName
        - Statement:
          - Sid: CloudWatchLogsAudit
            Effect: Allow
            Action:
              - logs:CreateLogStream
              - logs:PutLogEvents
              - logs:DescribeLogStreams
            Resource: !Sub arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:${AuditLogGroupName}:*
      Runtime: nodejs22.x

  LanguagesFunction:
    Type: "AWS::Serverless::Function"
    Properties:
      CodeUri:  ../../src/lambda
      Handler: languages.handler
      Environment:
        Variables:
          TableName: !Ref TableName
          RolesTableName: !Ref RolesTableName
          AuditLogGroupName: !Ref AuditLogGroupName
      Events:
        APIEvent:
          Type: Api
          Properties:
            RestApiId: !Ref Api
            Method: GET
            Path: /languages
      Policies:
        - DynamoDBReadPolicy:
            TableName: !Ref TableName
        - DynamoDBReadPolicy:
            TableName: !Ref RolesTableName
        - Statement:
          - Sid: CloudWatchLogsAudit
            Effect: Allow
            Action:
              - logs:CreateLogStream
              - logs:PutLogEvents
              - logs:DescribeLogStreams
            Resource: !Sub arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:${AuditLogGroupName}:*
      Runtime: nodejs22.x

  SwapFunction:
    Type: "AWS::Serverless::Function"
    Properties:
      CodeUri:  ../../src/lambda
      Handler: swap.handler
      Environment:
        Variables:
          TableName: !Ref TableName
          DataBucket: !Ref DataBucket
          RolesTableName: !Ref RolesTableName
          AuditLogGroupName: !Ref AuditLogGroupName
      Events:
        APIEvent:
          Type: Api
          Properties:
            RestApiId: !Ref Api
            Method: PUT
            Path: /swap/{key+}
      Policies:
        - S3CrudPolicy:
            BucketName: !Ref DataBucket
        - DynamoDBCrudPolicy:
            TableName: !Ref TableName
        - DynamoDBReadPolicy:
            TableName: !Ref RolesTableName
        - Statement:
          - Sid: CloudWatchLogsAudit
            Effect: Allow
            Action:
              - logs:CreateLogStream
              - logs:PutLogEvents
              - logs:DescribeLogStreams
            Resource: !Sub arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:${AuditLogGroupName}:*
      Runtime: nodejs22.x
  
  # Created only when GenAI query is enabled.
  #
  # Previously this function and its /genaiquery route were created unconditionally, and
  # GenAIQueryType only influenced a client-side flag that hid the chat panel. The
  # endpoint stayed live on a DISABLED deployment, and the handler performs no
  # authorization of its own, so any authenticated user could reach it. Worse, the
  # handler fetches the call transcript *before* it checks QUERY_TYPE, so "disabled"
  # suppressed the model call but not the transcript retrieval.
  #
  # Conditioning the resource removes the route entirely for the default DISABLED
  # configuration. It does not fix authorization when the feature IS enabled - that is
  # tracked separately, and needs a permission check inside the Python handler.
  #
  # Safe to condition: no Output or other resource references this function or its
  # implicit role. RolesForKMSKey below names only GetFunctionRole and SwapFunctionRole.
  GenAIQueryFunction:
    Condition: ShouldEnableGenAIQuery
    Type: "AWS::Serverless::Function"
    #
    # Known cfn-lint warning, accepted rather than suppressed: adding the Condition
    # above makes W1028 fire on the nested "Fn::If: HasAnthropicSummary" in Policies
    # below, reporting its else branch as unreachable. The finding is vacuous - it is
    # derived by exploring the case where ShouldEnableGenAIQuery is false, in which
    # this resource does not exist at all, so neither branch is reachable.
    #
    # Both branches are genuinely reachable in the worlds where the resource does
    # exist: GenAIQueryType ANTHROPIC takes the Secrets Manager statement, BEDROCK and
    # LAMBDA take AWS::NoValue. Resource-level Metadata suppression does not apply to
    # W1028 because it is evaluated against conditions rather than the resource, and a
    # global entry in .cfnlintrc.yaml would relax the rule for every template - so the
    # warning is left in place deliberately.
    Properties:
      CodeUri:  ../../src/genai
      Handler: index.lambda_handler
      Timeout: 900
      Layers:
        - !Ref PyUtilsLayerArn
      Environment:
        Variables:
          QUERY_TYPE: !Ref GenAIQueryType
          BEDROCK_MODEL_ID: !Ref GenAIQueryBedrockModelId
          FETCH_TRANSCRIPT_LAMBDA_ARN: !Ref FetchTranscriptArn
          ANTHROPIC_MODEL_IDENTIFIER: "claude-2"
          ANTHROPIC_ENDPOINT_URL: "https://api.anthropic.com/v1/complete"
          ANTHROPIC_API_KEY: !Ref LLMThirdPartyApiKey
          LLM_TABLE_NAME: !Ref LLMTableName
          # Required by pca_auth. This handler now checks the caller's role against the
          # roles table before reading any call content, and records denials in the
          # audit log group, matching what the Node handlers do.
          RolesTableName: !Ref RolesTableName
          AuditLogGroupName: !Ref AuditLogGroupName
      Events:
        APIEvent:
          Type: Api
          Properties:
            RestApiId: !Ref Api
            Method: GET
            Path: /genaiquery
      Policies:
        - arn:aws:iam::aws:policy/AmazonSSMReadOnlyAccess
        - S3CrudPolicy:
            BucketName: !Ref DataBucket
        - DynamoDBCrudPolicy:
            TableName: !Ref TableName
        - Statement:
          - Sid: InvokeGetTranscript
            Effect: Allow
            Action:
              - lambda:InvokeFunction
            Resource: !Ref FetchTranscriptArn
          - Sid: DynamoDBAccess
            Effect: Allow
            Resource: !Sub arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${LLMTableName}
            Action:
              - 'dynamodb:GetItem'
          - Sid: InvokeBedrock
            Effect: Allow
            Action:
              - bedrock:InvokeModel
            Resource:
              - !Sub arn:${AWS::Partition}:bedrock:*::foundation-model/*
              - !Sub arn:${AWS::Partition}:bedrock:*:${AWS::AccountId}:custom-model/*
              - !Sub arn:aws:bedrock:${AWS::Region}:${AWS::AccountId}:inference-profile/*
          - Sid: BedrockGetInferenceProfile
            Effect: Allow
            Action:
              - bedrock:GetInferenceProfile
            Resource:
              - !Sub arn:aws:bedrock:${AWS::Region}:${AWS::AccountId}:inference-profile/*
          # Authorization lookup. Read-only on the roles table, and scoped to that one
          # table rather than using DynamoDBReadPolicy, which would grant more.
          - Sid: RolesTableRead
            Effect: Allow
            Action:
              - 'dynamodb:GetItem'
            Resource: !Sub arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${RolesTableName}
          - Sid: CloudWatchLogsAudit
            Effect: Allow
            Action:
              - logs:CreateLogStream
              - logs:PutLogEvents
              - logs:DescribeLogStreams
            Resource: !Sub arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:${AuditLogGroupName}:*
          - !If 
              - HasAnthropicSummary
              - Sid: SecretsManagerPolicy
                Effect: Allow
                Action:
                  - 'secretsmanager:GetResourcePolicy'
                  - 'secretsmanager:GetSecretValue'
                  - 'secretsmanager:DescribeSecret'
                  - 'secretsmanager:ListSecretVersionIds'
                Resource: !Ref LLMThirdPartyApiKey
              - !Ref "AWS::NoValue"
      Runtime: python3.13

  GenAIRefreshSummaryFunction:
    Type: "AWS::Serverless::Function"
    Properties:
      CodeUri:  ../../src/genai
      Handler: refresh_summary.lambda_handler
      Timeout: 900
      Layers:
        - !Ref PyUtilsLayerArn
      Environment:
        Variables:
          SUMMARIZER_ARN: !Ref SummarizerArn
          # Required by pca_auth - this handler previously performed no authorization,
          # so any authenticated user could trigger a summary regeneration.
          RolesTableName: !Ref RolesTableName
          AuditLogGroupName: !Ref AuditLogGroupName
      Events:
        APIEvent:
          Type: Api
          Properties:
            RestApiId: !Ref Api
            Method: GET
            Path: /genai/refreshsummary
      Policies:
        - Statement:
          - Sid: InvokeGetSummary
            Effect: Allow
            Action:
              - lambda:InvokeFunction
            Resource: !Ref SummarizerArn
          # Authorization lookup, scoped to the roles table only.
          - Sid: RolesTableRead
            Effect: Allow
            Action:
              - 'dynamodb:GetItem'
            Resource: !Sub arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${RolesTableName}
          - Sid: CloudWatchLogsAudit
            Effect: Allow
            Action:
              - logs:CreateLogStream
              - logs:PutLogEvents
              - logs:DescribeLogStreams
            Resource: !Sub arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:${AuditLogGroupName}:*
      Runtime: python3.13

  GeneratePresignedURLFunction:
    Type: "AWS::Serverless::Function"
    Properties:
      CodeUri:  ../../src/lambda
      Handler: presign.handler
      Environment:
        Variables:
          AudioBucket: !Ref AudioBucket
          AudioBucketPrefix: !Ref AudioBucketPrefix
          RolesTableName: !Ref RolesTableName
          AuditLogGroupName: !Ref AuditLogGroupName
      Events:
        APIEvent:
          Type: Api
          Properties:
            RestApiId: !Ref Api
            Method: GET
            Path: /presign
      Policies:
        - S3WritePolicy:
            BucketName: !Ref AudioBucket
        - DynamoDBReadPolicy:
            TableName: !Ref RolesTableName
        - Statement:
          - Sid: CloudWatchLogsAudit
            Effect: Allow
            Action:
              - logs:CreateLogStream
              - logs:PutLogEvents
              - logs:DescribeLogStreams
            Resource: !Sub arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:${AuditLogGroupName}:*
      Runtime: nodejs22.x

  DeleteFunction:
    Type: "AWS::Serverless::Function"
    Properties:
      CodeUri: ../../src/lambda
      Handler: delete.handler
      Timeout: 60
      Environment:
        Variables:
          DataBucket: !Ref DataBucket
          AudioBucket: !Ref AudioBucket
          TranscribeResultsPrefix: !Ref TranscribeResultsPrefix
          RolesTableName: !Ref RolesTableName
          AuditLogGroupName: !Ref AuditLogGroupName
      Events:
        SingleDeleteEvent:
          Type: Api
          Properties:
            RestApiId: !Ref Api
            Method: DELETE
            Path: /delete/{key+}
        BatchDeleteEvent:
          Type: Api
          Properties:
            RestApiId: !Ref Api
            Method: POST
            Path: /delete/batch
      Policies:
        - DynamoDBReadPolicy:
            TableName: !Ref RolesTableName
        - S3CrudPolicy:
            BucketName: !Ref DataBucket
        - S3CrudPolicy:
            BucketName: !Ref AudioBucket
        - Statement:
          - Sid: CloudWatchLogsAudit
            Effect: Allow
            Action:
              - logs:CreateLogStream
              - logs:PutLogEvents
              - logs:DescribeLogStreams
            Resource: !Sub arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:${AuditLogGroupName}:*
      Runtime: nodejs22.x

  RolesFunction:
    Type: "AWS::Serverless::Function"
    Properties:
      CodeUri: ../../src/lambda
      Handler: roles.handler
      Environment:
        Variables:
          RolesTableName: !Ref RolesTableName
          AuditLogGroupName: !Ref AuditLogGroupName
      Events:
        ListRolesEvent:
          Type: Api
          Properties:
            RestApiId: !Ref Api
            Method: GET
            Path: /roles
        CreateRoleEvent:
          Type: Api
          Properties:
            RestApiId: !Ref Api
            Method: POST
            Path: /roles
        UpdateRoleEvent:
          Type: Api
          Properties:
            RestApiId: !Ref Api
            Method: PUT
            Path: /roles/{roleName}
        DeleteRoleEvent:
          Type: Api
          Properties:
            RestApiId: !Ref Api
            Method: DELETE
            Path: /roles/{roleName}
      Policies:
        - DynamoDBCrudPolicy:
            TableName: !Ref RolesTableName
        - Statement:
          - Sid: CloudWatchLogsAudit
            Effect: Allow
            Action:
              - logs:CreateLogStream
              - logs:PutLogEvents
              - logs:DescribeLogStreams
            Resource: !Sub arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:${AuditLogGroupName}:*
      Runtime: nodejs22.x

  UsersFunction:
    Type: "AWS::Serverless::Function"
    Properties:
      CodeUri: ../../src/lambda
      Handler: users.handler
      Environment:
        Variables:
          UserPoolId: !Ref UserPoolId
          RolesTableName: !Ref RolesTableName
          AuditLogGroupName: !Ref AuditLogGroupName
      Events:
        ListUsersEvent:
          Type: Api
          Properties:
            RestApiId: !Ref Api
            Method: GET
            Path: /users
        AssignRoleEvent:
          Type: Api
          Properties:
            RestApiId: !Ref Api
            Method: PUT
            Path: /users/{username}/role
      Policies:
        - DynamoDBReadPolicy:
            TableName: !Ref RolesTableName
        - Statement:
          - Sid: CognitoAdmin
            Effect: Allow
            Action:
              - cognito-idp:ListUsers
              - cognito-idp:AdminUpdateUserAttributes
              - cognito-idp:AdminGetUser
            Resource: !Sub arn:${AWS::Partition}:cognito-idp:${AWS::Region}:${AWS::AccountId}:userpool/${UserPoolId}
          - Sid: CloudWatchLogsAudit
            Effect: Allow
            Action:
              - logs:CreateLogStream
              - logs:PutLogEvents
              - logs:DescribeLogStreams
            Resource: !Sub arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:${AuditLogGroupName}:*
      Runtime: nodejs22.x

  PermissionsFunction:
    Type: "AWS::Serverless::Function"
    Properties:
      CodeUri: ../../src/lambda
      Handler: permissions.handler
      Environment:
        Variables:
          RolesTableName: !Ref RolesTableName
      Events:
        APIEvent:
          Type: Api
          Properties:
            RestApiId: !Ref Api
            Method: GET
            Path: /me/permissions
      Policies:
        - DynamoDBReadPolicy:
            TableName: !Ref RolesTableName
      Runtime: nodejs22.x

  RoleSeederFunction:
    Type: "AWS::Serverless::Function"
    Properties:
      CodeUri: ../../src/lambda
      Handler: role-seeder.handler
      Timeout: 60
      Environment:
        Variables:
          RolesTableName: !Ref RolesTableName
          UserPoolId: !Ref UserPoolId
          AdminUsername: !Ref AdminUsername
      Policies:
        - DynamoDBCrudPolicy:
            TableName: !Ref RolesTableName
        - Statement:
          - Sid: CognitoAdmin
            Effect: Allow
            Action:
              - cognito-idp:AdminUpdateUserAttributes
              - cognito-idp:AdminGetUser
              - cognito-idp:DescribeUserPool
            Resource: !Sub arn:${AWS::Partition}:cognito-idp:${AWS::Region}:${AWS::AccountId}:userpool/${UserPoolId}
      Runtime: nodejs22.x

  RoleSeeder:
    Type: Custom::RoleSeeder
    Properties:
      ServiceToken: !GetAtt RoleSeederFunction.Arn

Outputs:
  Uri:
    Value: !Sub https://${Api}.execute-api.${AWS::Region}.amazonaws.com/Prod

  RolesForKMSKey:
    Value: !Join
      - ', '
      - - !Sub '"${GetFunctionRole.Arn}"'
        - !Sub '"${SwapFunctionRole.Arn}"'